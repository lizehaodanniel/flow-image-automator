{
  "manifest_version": 3,
  "name": "AICheatCode",
  "version": "1.3.16",
  "description": "批量向 Google Flow 提交提示词，自动生成并下载图片/视频。免费自托管版：多模式（文生图/文生视频/图生视频/成分动画/图生图）、画幅/模型/时长、重试、随机延迟、按项目建文件夹。v1.3.16 新增「角色参考图」功能：在侧边栏选一张人物图并启用，扩展自动切到图生图模式，把该图作为整批生成的基准图，实现人物视觉一致；参考图持久化，以后打开自动生效。",
  "permissions": ["downloads", "storage", "tabs", "sidePanel", "scripting", "debugger"],
  "host_permissions": [
    "https://labs.google/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["https://labs.google/fx/*"],
    "js": ["content_script.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AICheatCode",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "minimum_chrome_version": "114"
}

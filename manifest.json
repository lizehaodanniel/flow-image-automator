{
  "manifest_version": 3,
  "name": "AICheatCode",
  "version": "1.3.15",
  "description": "批量向 Google Flow 提交提示词，自动生成并下载图片/视频。免费自托管版：多模式（文生图/文生视频/图生视频/成分动画/图生图）、画幅/模型/时长、重试、随机延迟、按项目建文件夹。v1.3.14 实现图生视频与成分动画的自动上传图片素材（在侧边栏「素材图片」选图，扩展自动注入 Flow 并驱动生成），并支持中英文界面切换。",
  "permissions": ["downloads", "storage", "tabs", "sidePanel", "scripting", "debugger"],
  "host_permissions": [
    "https://labs.google/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["https://labs.google/fx/*"],
    "js": ["content_script.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AICheatCode",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "minimum_chrome_version": "114"
}

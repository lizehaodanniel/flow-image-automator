{
  "manifest_version": 3,
  "name": "AICheatCode",
  "version": "1.3.17",
  "description": "批量向 Google Flow 提交提示词，自动生成并下载图片/视频。免费自托管版：多模式（文生图/文生视频/图生视频/成分动画/图生图）、画幅/模型/时长、重试、随机延迟、按项目建文件夹。v1.3.17 修复批量角色固定下的「同提示词重复生成」「图生图链式漂移」「第 4 张之后卡死」三大问题：上传验证改为「新增图」识别；新建项目验证旧媒体清空；提示词读回验证；service worker 心跳保活。",
  "permissions": ["downloads", "storage", "tabs", "sidePanel", "scripting", "debugger", "alarms"],
  "host_permissions": [
    "https://labs.google/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["https://labs.google/fx/*"],
    "js": ["content_script.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AICheatCode",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "minimum_chrome_version": "114"
}

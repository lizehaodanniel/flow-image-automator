{
  "manifest_version": 3,
  "name": "AICheatCode",
  "version": "1.3.20",
  "description": "批量向 Google Flow 提交提示词，自动生成并下载图片/视频。免费自托管版：多模式（文生图/文生视频/图生视频/成分动画/图生图）、画幅/模型/时长、重试、随机延迟、按项目建文件夹。v1.3.20 修「固定角色参考图上传卡住」：文件注入改用原生 files setter 更兼容 React；上传成功判定放宽（新 img/缩略图 div/已注入 input 均算成功），不再因新版把参考图放进媒体库而误判失败。",
  "permissions": ["downloads", "storage", "tabs", "sidePanel", "scripting", "debugger", "alarms"],
  "host_permissions": [
    "https://labs.google/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["https://labs.google/fx/*"],
    "js": ["content_script.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AICheatCode",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "minimum_chrome_version": "114"
}
